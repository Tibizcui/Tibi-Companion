{
  "name": "tibi-companion",
  "productName": "Tibi Companion",
  "version": "2.0.5",
  "description": "Compagnon PC de TibiSuite : synchronise et affiche automatiquement ton dashboard de statistiques (module Stats) sans copier-coller de code.",
  "main": "src/main/main.js",
  "author": "Tibiscui",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Tibizcui/Tibi-Companion.git"
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder --win --mac"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "fr.tibiscui.companion",
    "productName": "Tibi Companion",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "appx"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "appx": {
      "applicationId": "TibiCompanion",
      "identityName": "Tibizcui.TibiCompanion",
      "publisher": "CN=FDF6D71C-1DC5-4359-B521-AD39A9CE98D5",
      "publisherDisplayName": "Tibizcui",
      "displayName": "Tibi Companion"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    }
  }
}
